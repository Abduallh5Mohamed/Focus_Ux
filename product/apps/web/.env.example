# Copy to `.env.local` and fill in. Never commit real secrets.

# Base URL of the FOCUS API (product/services/api). Leave empty for same-origin.
# Example: VITE_API_BASE_URL=https://focus-api.example.com
VITE_API_BASE_URL=

# Dev-only mock API. Keep it OFF for anything that looks like a demo.
# It is also enabled by `npm run dev:mock` through .env.mock.
VITE_DEV_MOCK_API=0
